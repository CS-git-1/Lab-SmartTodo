{
  "info": {
    "_postman_id": "c67dc7a3-1db7-46d7-99e1-818160365a39",
    "name": "Smart Todo API - Azure SQL Server",
    "description": "Set baseUrl, email, and password. Register creates an account and should be run once with a new email. Login stores the HttpOnly session cookie in Postman cookie jar; CRUD requests use that session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registers account', () => pm.response.to.have.status(201));",
                  "pm.test('sets an HttpOnly session cookie', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly'));",
                  "pm.test('returns user without exposing token', () => pm.expect(pm.response.json().data.user).to.be.an('object')); "
                ]
              }
            }
          ]
        },
        {
          "name": "Login and save session cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('sets an HttpOnly session cookie', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly'));",
                  "pm.test('returns the signed-in user without exposing the token', () => pm.expect(pm.response.json().data.user).to.be.an('object')); "
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns current user', () => pm.response.to.have.status(200));",
                  "pm.test('returns user identity', () => pm.expect(pm.response.json().data).to.have.property('id')); "
                ]
              }
            }
          ]
        }
      ]
    },
