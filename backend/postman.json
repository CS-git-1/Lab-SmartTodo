    {
      "name": "Tasks CRUD (run in order)",
      "description": "Run Register once with a new email, or skip it and provide an existing account for Login. Postman stores the HttpOnly session cookie automatically. Run CRUD requests in order: POST saves taskId for PUT and DELETE; Logout is last.",
      "item": [
        {
          "name": "Create task validation (blank title)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects invalid task data', () => pm.response.to.have.status(400));",
                  "pm.test('returns a validation error code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task - save taskId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"  Postman test task  \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates task', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns a task ID', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('taskId', body.data.id);",
                  "pm.test('trims title before saving', () => pm.expect(body.data.title).to.eql('Postman test task'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks (GET /api/tasks) - Filters and pagination",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?page=1&limit=10&status=todo&priority=2&q=Postman",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('lists tasks', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns data array', () => pm.expect(body.data).to.be.an('array'));",
                  "if (body.data.length > 0) pm.test('includes pagination metadata', () => pm.expect(body.pagination).to.have.property('total'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject page above maximum",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?page=10001&limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects page above 10000', () => pm.response.to.have.status(400));",
                  "pm.test('returns validation error', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR')); "
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks (GET /api/tasks) - Empty result",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks?q=__no_matching_task__"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 for an empty result', () => pm.response.to.have.status(200));",
                  "pm.test('matches empty contract', () => pm.expect(pm.response.json()).to.eql({ data: [] }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get task by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('gets task', () => pm.response.to.have.status(200));",
                  "pm.test('returns the created task', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('taskId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated by Postman\",\n  \"status\": \"in_progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('updates task', () => pm.response.to.have.status(200));",
                  "pm.test('returns updated values', () => { const body = pm.response.json(); pm.expect(body.data.title).to.eql('Updated by Postman'); pm.expect(body.data.status).to.eql('in_progress'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace task (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Replaced task title\",\n  \"isCompleted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replaces task', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns trimmed replacement and completed state', () => { pm.expect(body.data.title).to.eql('Replaced task title'); pm.expect(body.data.isCompleted).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace missing task (404)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing task\",\n  \"isCompleted\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tasks/00000000-0000-4000-8000-000000000001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 404 for missing task', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete task and child data",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deletes task without a response body', () => { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete missing task (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/00000000-0000-4000-8000-000000000001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 404 for missing task', () => pm.response.to.have.status(404));",
                  "pm.test('uses standard error envelope', () => pm.expect(pm.response.json().error.code).to.eql('TASK_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Legacy API alias list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks?page=1&limit=10",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('legacy alias is available', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout and clear session cookie",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logs out', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
