PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters

# SQL Server connection
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=SmartTodo
DB_USER=your-sql-user
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_LOGIN_TIMEOUT=30
DB_REQUEST_TIMEOUT=30
HOST=0.0.0.0

# Password reset email (required to enable forgot-password flow)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
